<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="primary">#2E7D32</color>
    <color name="primary_dark">#1B5E20</color>
    <color name="on_primary">#FFFFFF</color>
    <color name="accent">#FF6F00</color>

    <!-- Text color for AlertDialog buttons (Save/Cancel/Delete). Dark-mode equivalent below is
         lighter, since the plain "primary" green is too dark to read against a near-black
         dialog surface. -->
    <color name="dialog_button_color">@color/primary</color>

    <!-- Destructive-action red for delete buttons/menu items and their confirming dialog
         button, so they stand out from the theme's green everywhere they appear. Dark-mode
         equivalent below is lighter, for the same dialog-surface-contrast reason as
         dialog_button_color. -->
    <color name="delete_color">#D32F2F</color>

    <color name="status_expired">#C62828</color>
    <color name="status_soon">#EF6C00</color>
    <color name="status_ok">#424242</color>

    <color name="background_light">#FAFAFA</color>
    <color name="background_dark">#121212</color>

    <!-- Product list card backgrounds by expiry status. Dark-mode equivalents are in
         values-night/colors.xml: same red/yellow/green pattern, muted for a dark surface. -->
    <color name="card_expired">#FFCDD2</color>
    <color name="card_near_expiry">#FFE0B2</color>
    <color name="card_fresh">#C8E6C9</color>
    <!-- Exhausted (0 units left) overrides the expiry-status color above; neutral grey so it
         reads as a distinct "used up" state rather than another expiry-urgency level. -->
    <color name="card_exhausted">#E0E0E0</color>
</resources>
