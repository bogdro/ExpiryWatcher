<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string-array name="default_units">
        <item>can</item>
        <item>jar</item>
        <item>box</item>
        <item>bag</item>
        <item>package</item>
        <item>pcs</item>
        <item>g</item>
        <item>kg</item>
        <item>ml</item>
        <item>l</item>
    </string-array>

    <!-- Order must match bogdrosoft.expirymanager.util.SortOrder's enum declaration order,
         since its ordinal is used both as the picker's selected index and as the DB sort mode. -->
    <string-array name="sort_order_options">
        <item>@string/sort_order_default</item>
        <item>@string/sort_order_expiry_asc</item>
        <item>@string/sort_order_expiry_desc</item>
        <item>@string/sort_order_name_asc</item>
        <item>@string/sort_order_name_desc</item>
        <item>@string/sort_order_type_asc</item>
        <item>@string/sort_order_type_desc</item>
        <item>@string/sort_order_container_asc</item>
        <item>@string/sort_order_container_desc</item>
    </string-array>

    <!-- Order must match bogdrosoft.expirymanager.util.UiMode's enum declaration order, since
         its ordinal is used as the settings dropdown's selected index. -->
    <string-array name="ui_mode_options">
        <item>@string/ui_mode_system_default</item>
        <item>@string/ui_mode_light</item>
        <item>@string/ui_mode_dark</item>
    </string-array>
</resources>
