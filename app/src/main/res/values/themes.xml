<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ExpiryManager" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/background_light</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.ExpiryManager.AlertDialog</item>
    </style>

    <!-- Recolors AlertDialog buttons (Save/Cancel/Delete) with a day/night-aware color, since
         the app's plain "colorPrimary" green is too dark to read against the dark-mode dialog
         surface otherwise. -->
    <style name="ThemeOverlay.ExpiryManager.AlertDialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="colorPrimary">@color/dialog_button_color</item>
    </style>
</resources>
